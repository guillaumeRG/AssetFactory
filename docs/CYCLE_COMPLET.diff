+        magic, version, length = struct.unpack("<4sII", header)
+        if magic != b"glTF" or version != 2 or length != path.stat().st_size:
+            raise ValueError(f"Invalid GLB 2.0 header or length: {path}")
+        chunk_header = handle.read(8)
