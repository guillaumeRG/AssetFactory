{
  "schemaVersion": 1,
  "defaultMethod": "trellis-multi-image",
  "methods": {
    "trellis-multi-image": {
      "provider": "trellis",
      "type": "multiview-to-3d",
      "runner": "tools/run-trellis.ps1",
      "parameters": {
        "fusionMode": "stochastic",
        "includeReference": true,
        "simplify": 0.95,
        "textureSize": 1024,
        "viewPolicy": "quality",
        "maxViews": 4,
        "minViewScore": 45.0
      }
    }
  }
}